QLIB_PROVIDER_URI=
JPX_UNIVERSE_PATH=data/universe_jp.csv
JPX_OUTPUT_CSV=output/recommendations.csv
JPX_SNAPSHOT_DIR=data/snapshots
JPX_TOP_K=10
JPX_INTERVAL_MINUTES=1440
JPX_TIMEZONE=Asia/Tokyo
JPX_DATABASE_URL=postgresql://jpx:jpxpass@localhost:5432/jpx_alpha
JPX_PREDICTION_HORIZON_MINUTES=1440
JPX_LEARNING_RATE=0.01
JPX_BACKFILL_YEARS=5

JPX_FAILURE_STATE_PATH=data/universe_failures.json
JPX_FAILURE_THRESHOLD=3
JPX_SUPPRESS_YF_WARNINGS=true

